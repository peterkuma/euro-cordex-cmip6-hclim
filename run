#!/usr/bin/env bash
set -e
shopt -s nullglob

CPUS_TO_JOBS_FACTOR=2

FREQS=(
	day
	mon
)

FREQS_ENS=(
	mon
	yr
)

STAGES=(
	core
	tier1
)

INPUT_VARS=(
	tas
	pr
	psl
	tasmin
	tasmax
)

VARS=(
	tas
	pr
	psl
	tasmin
	tasmax
	su
	gsstart
)

PERIODS=(
	"1991 2020"
    "2071 2100"
)

PERIOD_PAIRS=(
	"1991 2020 2071 2100"
)

SEASONS=(
	ANN
	MAM
	JJA
	SON
	DJF
)

REGIONS=(
	BI
	IP
	FR
	ME
	SC
	AL
	MD
	EA
)

LISTS=(
	hclim_historical+ssp126
	hclim_historical+ssp370
	gcm_historical+ssp126
	gcm_historical+ssp370
)

LISTS_ENS=(
	hclim_ens_historical+ssp126
	hclim_ens_historical+ssp370
	gcm_ens_historical+ssp126
	gcm_ens_historical+ssp370
)

LISTS_INDICES=(
	hclim_historical+ssp370_day
)

LISTS_MAP_MEAN=(
	hclim_historical+ssp126
	gcm_historical+ssp126
)

LISTS_MAP_DIFF=(
	hclim_historical+ssp370
)

LISTS_MAP_TREND=(
	hclim_historical+ssp126
)

LISTS_HEATMAP_MEAN=(
	hclim_historical+ssp126
)

LISTS_HEATMAP_DIFF=(
	hclim_historical+ssp370
)

LISTS_HEATMAP_TREND=(
	hclim_historical+ssp126
)

LISTS_ARCHIVE=(
	hclim_historical+ssp126
)

LISTS_CLIM_INDICES=(
	obs
	hclim_historical+ssp370
)

SUBTYPES=(
	period_season
	period_season_region
)

INDICES=(
	sd
)

ARCHIVE_VARS=(
	tas
	pr
	psl
	tasmin
	tasmax
)

task=$1

export PARALLEL=--no-notice

tmp=$(mktemp)
tmp_final=$(mktemp)
trap 'rm -- "$tmp" "$tmp_final"' EXIT

cmd () {
	echo $* >> "$tmp"
}

run () {
	njobs=$(("$(nproc)"/"$CPUS_TO_JOBS_FACTOR"))
	[[ njobs == 0 ]] && njobs=1
	# cat "$tmp"
	status=0
	parallel -tuj "$njobs" < "$tmp" || status="$?"
	if [[ $status != 0 ]]; then
		echo "ERROR: parallel returned non-zero exit status $status" >&2
		exit "$status"
	fi
	echo > "$tmp"
}

calc_stats () {
	local input=$1
	local list=$2
	local subtype=$3
	local out=$4
	mkdir -p "$out"
	for source in $(cat "sources/list/${list}"); do
		for period in "${PERIODS[@]}"; do
			for season in "${SEASONS[@]}"; do
				for var in "${VARS[@]}"; do
					[[ ( $var == su || $var == gsstart ) && $season != ANN ]] \
						&& continue
					if [[ $subtype == "period_season_region" ]]; then
						for region in "${REGIONS[@]}"; do
							cmd bin/calc_stats \
								"$input/$source" \
								"$source" \
								$period \
								"$season" \
								"$region" \
								"$var" \
								"$out"
						done
					else
						cmd bin/calc_stats \
							"$input/$source" \
							"$source" \
							$period \
							"$season" \
							"$var" \
							"$out"
					fi
				done
			done
		done
	done
}

plot_map () {
	local args=("$@")
	local type_=${args[0]}
	local in=${args[1]}
	local out=${args[2]}
	local sources=${args[@]:3}
	mkdir -p "$out"
	for var in "${VARS[@]}"; do
		for season in "${SEASONS[@]}"; do
			if [[ $type_ == diff ]]; then
				for period in "${PERIOD_PAIRS[@]}"; do
					cmd bin/plot_map \
						"$type_" \
						"$var" \
						"$season" \
						$period \
						"$in" \
						$sources \
						"$out"
				done
			else
				for period in "${PERIODS[@]}"; do
					cmd bin/plot_map \
						"$type_" \
						"$var" \
						"$season" \
						$period \
						"$in" \
						$sources \
						"$out"
				done
			fi
		done
	done
}

convert_png () {
	local dir=$1
	out=$dir/png
	mkdir -p "$out"
	for file in "$dir/"*.pdf; do
		cmd \
			convert \
			-density 600 \
			"$file" \
			"$out/$(basename "${file%.pdf}").png"
	done
}

case "$task" in

"")
	cat <<EOF
Usage: run TASK

Tasks:

  source_links          Create source symlinks in the input directory.
  remap_landmask        Remap land mask to a 1x1 degree grid for GCM calculations.
  remap_obs             Remap observatiosn to a 1x1 degree grid for GCM calculations.
  calc_ensembles        Calculate model ensembles.
  calc_stats            Calculate statistics (dep: source_links, remap_landmask, remap_obs, ensemble).
  calc_clim_indices     Calculate climate indices.
  calc_model_ranking    Calculate model ranking (dep: calc_stats).
  plot_map_mean         Plot maps for means (dep: calc_stats).
  plot_map_diff         Plot maps for differences between time periods (dep: calc_stats).
  plot_map_trend        Plot maps for linear trends (dep: calc_stats).
  plot_heatmap_mean     Plot heatmaps for means (dep: calc_stats).
  plot_heatmap_diff     Plot heatmaps for differences between time periods (dep: calc_stats).
  plot_heatmap_trend    Plot heatmaps for trends (dep: calc_stats).
  plot_boxplot          Plot boxplots with statistics (dep: calc_stats).
  plot_gcm_rcm_scatter  Plot GCM-RCM scatter plot for temperature and precipitation (dep: calc_stats).
  plot_model_ranking    Plot model ranking (dep: model_ranking).
  plot_timeseries       Plot time series (dep: calc_stats).
  plot_annual_cycle     Plot annual cycle (dep: calc_stats).
  plot_gcm_rcm_tas      Plot GCM. vs RCM. temperature change.
  download_topo         Download topography.
  remap_topo            Remap topography (dep: download_topo).
  plot_domain_map       Plot domain map (dep: remap_topo).
  archive               Prepare an archive of input data.
EOF
	;;

source_links)
	out=data/sources
	for file in sources/paths/*; do
		while read -r line; do
			for stage in "${STAGES[@]}"; do
				for freq in "${FREQS[@]}"; do
					for var in "${INPUT_VARS[@]}"; do
						s=$(echo "$line" | \
							stage=$stage \
							freq=$freq \
							var=$var \
							envsubst \
						)
						items=($s)
						name=${items[0]}
						out1=$out/$name/$freq/$var
						for path in ${items[@]:1}; do
							for file in "$path/${var}_"*.nc; do
								if [ -e "$file" ]; then
									mkdir -p "$out1"
									cmd ln -fs "$file" -t "$out1/"
								fi
							done
						done
					done
				done
			done
		done < "$file"
	done
	;;

remap_landmask)
	out=data/landmask
	mkdir -p "$out"
	cmd cdo \
		remapbil,r360x180 \
		input/landmask/sftlf_EUR-12_ERA5_evaluation_r1i1p1f1_HCLIMcom-SMHI_HCLIM43-ALADIN_v1-r1_fx.nc \
		"$out/sftlf_EUR-12_ERA5_evaluation_r1i1p1f1_HCLIMcom-SMHI_HCLIM43-ALADIN_v1-r1_fx_1x1deg.nc"
	;;

remap_obs)
	for source in $(cat sources/list/obs); do
		for freq in "${FREQS[@]}"; do
			for var in "${VARS[@]}"; do
				out=data/1deg/$source/$freq/$var
				for file in "data/sources/$source/$freq/$var/"*.nc; do
					mkdir -p "$out"
					cmd cdo \
						remapbil,r360x180 \
						"$file" \
						"$out/$(basename "$file")"
				done
			done
		done
	done
	;;

calc_ensembles)
	CPUS_TO_JOBS_FACTOR=4
	mkdir -p data/ensembles
	for list in "${LISTS_ENS[@]}"; do
		for freq in "${FREQS_ENS[@]}"; do
			for var in "${VARS[@]}"; do
				cmd bin/calc_ensemble \
					"$freq" \
					"$var" \
					data/sources $(cat "sources/list/$list") \
					data/ensembles
			done
		done
	done
	run
	for file in data/ensembles/*/*/*/*.nc; do
		path=${file#data/ensembles/}
		dir=$(dirname "$path")
		out=data/sources/$dir
		mkdir -p "$out"
		ln -sf "../../../../ensembles/$path" -t "$out/"
	done
	;;

calc_stats)
	for list in "${LISTS[@]}"; do
		for subtype in "${SUBTYPES[@]}"; do
			calc_stats data/sources \
				"$list" \
				"$subtype" \
				"data/stats/$list/$subtype"
		done
	done
	for subtype in "${SUBTYPES[@]}"; do
		calc_stats data/sources obs "$subtype" "data/stats/obs/$subtype"
		calc_stats data/1deg obs "$subtype" "data/stats/obs_1deg/$subtype"
	done
	run
	for list in "${LISTS[@]}"; do
		for subtype in "${SUBTYPES[@]}"; do
			dir=$([[ "$list" == gcm_* ]] && echo obs_1deg || echo obs)
			parallel ln -sf "../../$dir/$subtype/{/}" "data/stats/$list/$subtype" \
				::: "data/stats/$dir/$subtype"/*
		done
	done
	for list in "${LISTS[@]}"; do
		for subtype in "${SUBTYPES[@]}"; do
			cmd bin/index "data/stats/$list/$subtype"
		done
	done
	;;

calc_clim_indices)
	CPUS_TO_JOBS_FACTOR=4
	for list in "${LISTS_CLIM_INDICES[@]}"; do
		for source in $(cat "sources/list/$list"); do
			dir=data/sources/$source
			for f in "$dir/day/tasmax/"*.nc; do
				outdir=data/clim_indices/$source/yr/su
				name=$(basename "$f")
				out="$outdir/su_${name#*_}"
				mkdir -p "$outdir"
				cmd bin/calc_clim_index su "$f" "$out"
			done
			for f in "$dir/day/tas/"*.nc; do
				outdir=data/clim_indices/$source/yr/gsstart
				name=$(basename "$f")
				out="$outdir/gsstart_${name#*_}"
				mkdir -p "$outdir"
				cmd bin/calc_clim_index gsstart "$f" "$out"
			done
		done
	done
	run
	for file in data/clim_indices/*/*/*/*.nc; do
		path=${file#data/clim_indices/}
		dir=$(dirname "$path")
		out=data/sources/$dir
		mkdir -p "$out"
		ln -sf "../../../../clim_indices/$path" -t "$out/"
	done
	;;

calc_model_ranking)
	out=data
	mkdir -p "$out"
	cmd bin/calc_model_ranking \
		data/stats/hclim_historical+ssp126/period_season_region \
		$(cat sources/list/hclim_historical+ssp126_ranking) \
		1991 2020 \
		"$out/model_ranking.nc"
	;;

plot_map_mean)
	for list in "${LISTS_MAP_MEAN[@]}"; do
		plot_map \
			mean \
			"data/stats/$list/period_season" \
			"plot/map_mean/$list" \
			$(cat sources/list/{obs,"$list"})
	done
	;;

plot_map_diff)
	for list in "${LISTS_MAP_DIFF[@]}"; do
		plot_map \
			diff \
			"data/stats/$list/period_season" \
			"plot/map_diff/$list" \
			$(cat "sources/list/$list")
	done
	;;

plot_map_trend)
	for list in "${LISTS_MAP_TREND[@]}"; do
		plot_map \
			trend \
			"data/stats/$list/period_season" \
			"plot/map_trend/$list" \
			$(cat sources/list/{obs,"$list"})
	done
	;;

plot_heatmap_mean)
	for list in "${LISTS_HEATMAP_MEAN}"; do
		out=plot/heatmap_mean/$list
		mkdir -p "$out"
		cmd bin/plot_heatmap \
			mean \
			"data/stats/$list/period_season_region" \
			$(cat sources/list/{obs,"$list"}) \
			"$out"
	done
	;;

plot_heatmap_diff)
	for list in "${LISTS_HEATMAP_DIFF}"; do
		out=plot/heatmap_diff/$list
		mkdir -p "$out"
		cmd bin/plot_heatmap \
			diff \
			"data/stats/$list/period_season_region" \
			$(cat "sources/list/$list") \
			"$out"
	done
	;;

plot_heatmap_trend)
	for list in "${LISTS_HEATMAP_TREND}"; do
		out=plot/heatmap_trend/$list
		mkdir -p "$out"
		cmd bin/plot_heatmap \
			trend \
			"data/stats/$list/period_season_region" \
			$(cat sources/list/{obs,"$list"}) \
			"$out"
	done
	;;

plot_boxplot)
	out=plot/boxplot
	mkdir -p "$out"
	cmd bin/plot_boxplot \
		data/stats/hclim_historical+ssp126/period_season_region \
		$(cat sources/list/{obs,hclim_historical+ssp126}) \
		1991 2020 \
		"$out"
	out=plot/boxplot_relative
	mkdir -p "$out"
	cmd bin/plot_boxplot_relative \
		data/stats/hclim_historical+ssp126/period_season_region \
		$(cat sources/list/{obs,hclim_historical+ssp126}) \
		1991 2020 \
		"$out"
	;;

plot_gcm_rcm_scatter)
	out=plot
	mkdir -p "$out"
	cmd bin/plot_gcm_rcm_scatter \
		data/stats/{gcm_historical+ssp126,hclim_historical+ssp126}/period_season_region \
		$(cat sources/list/hclim_historical+ssp126) \
		1991 2020 \
		"$out/gcm_rcm_scatter.pdf"
	;;

plot_model_ranking)
	out=plot
	mkdir -p "$out"
	cmd bin/plot_model_ranking data/model_ranking.nc "$out/model_ranking.pdf"
	;;

plot_timeseries)
	out=plot/timeseries
	mkdir -p "$out"
	cmd bin/plot_timeseries \
		data/stats/hclim_historical+ssp370/period_season_region \
		$(cat sources/list/hclim_historical+ssp370) \
		1991 2020 \
		1991 2100 \
		2071 2100 \
		"$out/hclim_historical+ssp370.pdf"
	;;

plot_annual_cycle)
	out=plot
	mkdir -p "$out"
	cmd bin/plot_annual_cycle \
		data/stats/hclim_historical+ssp370/period_season_region \
		$(cat sources/list/hclim_historical+ssp370) \
		1991 2020 \
		2071 2100 \
		"$out/annual_cycle.pdf"
	;;

plot_gcm_rcm_tas)
	out=plot/gcm_rcm_tas
	mkdir -p "$out"
	cmd bin/plot_gcm_rcm_tas \
		data/stats/gcm_historical+ssp370/period_season_region \
		data/stats/hclim_historical+ssp370/period_season_region \
		$(cat sources/list/hclim_ens_historical+ssp370) \
		1991 2020 \
		2071 2100 \
		"$out"
	;;

download_topo)
	wget -cO data/GMTED2010_mean_30arcsec.nc4 \
		'https://zenodo.org/records/14537811/files/GMTED2010_mean_30arcsec.nc4?download=1'
	;;

remap_topo)
	rm -f data/topo.nc
	cmd cdo \
		remapcon,r2880x1440 \
		-sellonlatbox,-60,80,10,80 \
		data/GMTED2010_mean_30arcsec.nc4 \
		data/topo.nc
	;;

plot_domain_map)
	cmd bin/plot_domain_map data/topo.nc plot/domain_map.pdf
	;;

archive)
	rm -rf data/archive
	out=data/archive
	mkdir -p "$out"
	ln -s "$(realpath input/landmask)" "$out/"
	ln -s "$(realpath input/gcm_ecs_tcr.csv)" "$out/"
	for list in "${LISTS_ARCHIVE[@]}"; do
		for source in $(cat sources/list/{obs,"$list"}); do
			[[ $source == EUR-12_ENS* ]] && continue
			out=data/archive/sources/${source}_mon
			mkdir -p "$out"
			for var in "${ARCHIVE_VARS[@]}"; do
				start=1991-01-01
				end=2021-01-01
				for f in "data/sources/${source}/mon/${var}"/*.nc; do
					f=$(realpath "$f")
					cmd "bin/has_time $start $end $f && ln -sf $f $out/"
				done
			done
		done
	done
	;;

*)
	echo "$0: unknown task \"$task\"" >&2
	exit 1

esac

run
